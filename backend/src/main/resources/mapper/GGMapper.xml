<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atguigu.mqtt.mapper.GGMapper">
    <select id="getGg" resultType="com.atguigu.mqtt.domain.Figure">
        SELECT room AS id, time, gg AS number
        FROM gg
        <where>
        <if test="id != null">
            AND room = #{id}
        </if>
        <if test="min != null">
            AND gg &gt;= #{min}
        </if>
        <if test="max != null">
            AND gg &lt;= #{max}
        </if>
        <if test="startTime != null and startTime != ''">
            AND time &gt;= #{startTime}
        </if>
        <if test="endTime != null and endTime != ''">
            AND time &lt;= #{endTime}
        </if>
        </where>
        ORDER BY time DESC
    </select>
</mapper>