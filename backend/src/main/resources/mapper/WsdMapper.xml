<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.atguigu.mqtt.mapper.WsdMapper">
    <select id="getWsd" resultType="com.atguigu.mqtt.domain.wsdDTO">
        SELECT id AS byid,room AS id, time,wd AS temp, sd AS humi
        FROM wsd
        <where>
            <if test="id != null">
                AND room = #{id}
            </if>
            <if test="startTime != null and startTime != ''">
                AND time &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND time &lt;= #{endTime}
            </if>
        <if test="minTemp != null">
            AND wd &gt;= #{minTemp}
        </if>
        <if test="maxTemp != null">
            AND wd &lt;= #{maxTemp}
        </if>
        <if test="minhumi != null">
            AND sd &gt;= #{minhumi}
        </if>
        <if test="maxhumi != null">
            AND sd &lt;= #{maxhumi}
        </if>
        </where>
        ORDER BY time DESC
    </select>
</mapper>